# URL of the academy-os app that "Start now" links to
NEXT_PUBLIC_APP_URL=http://localhost:3000

# TULSI founder's LinkedIn profile (footer)
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/tulsimani-kumar

# WhatsApp number in international format, digits only, no + or spaces (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=919326636546

# --- Admin panel (/admin) ---------------------------------------------------
# Shared Postgres for BOTH landing sites. Every row carries a `site` column, so
# the two panels read the same database without seeing each other's traffic.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs the admin session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="GNDfAcQcJqIYgxRsNxKnLO5O37l6Dq8nOS2eeVP9jRY="

# Single admin password for /admin/login.
ADMIN_PASSWORD="Admin@123"


# --- Blog (Sanity CMS) ------------------------------------------------------
# Public identifiers, not secrets: the dataset is public and the client only
# reads published documents. Both landing sites share ONE Sanity project and
# dataset; each post carries a `sites` array, so this value is identical here
# and in the other site. Leave the projectId empty to disable the blog — every
# query short-circuits to an empty listing rather than erroring.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
