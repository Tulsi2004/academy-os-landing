# --- Blog (Sanity CMS) ------------------------------------------------------
# Public identifiers, not secrets: the dataset is public and the client only
# reads published documents. Both landing sites share ONE Sanity project and
# dataset; each post carries a `sites` array, so this value is identical here
# and in the other site. Leave the projectId empty to disable the blog — every
# query short-circuits to an empty listing rather than erroring.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
